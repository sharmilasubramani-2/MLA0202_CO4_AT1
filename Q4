import warnings
warnings.filterwarnings('ignore')

import sklearn_crfsuite

print("NAME: SHARMILA S")
print("REGISTER NO: 192525011\n")

def extract_features(sentence, i):
    word = sentence[i]
    return {
        'word': word,
        'is_first': i == 0,
        'is_last': i == len(sentence) - 1,
        'is_capitalized': word[0].isupper(),
        'is_numeric': word.isdigit(),
        'prefix-2': word[:2],
        'suffix-2': word[-2:]
    }

train_sentences = [
    ['Rahul', 'ordered', 'iPhone', 'with', 'order', '9841'],
    ['Priya', 'returned', 'MacBook', 'under', 'id', '4421'],
    ['Amit', 'bought', 'Headphones', 'tracking', '8812']
]

train_labels = [
    ['B-PER', 'O', 'B-PROD', 'O', 'O', 'B-ID'],
    ['B-PER', 'O', 'B-PROD', 'O', 'O', 'B-ID'],
    ['B-PER', 'O', 'B-PROD', 'O', 'B-ID']
]

X_train = [[extract_features(s, i) for i in range(len(s))] for s in train_sentences]
y_train = train_labels

crf = sklearn_crfsuite.CRF(algorithm='lbfgs', max_iterations=100)
crf.fit(X_train, y_train)

test_sentence = ['Ananya', 'purchased', 'Laptop', 'reference', '1092']
X_test = [[extract_features(test_sentence, i) for i in range(len(test_sentence))]]

y_pred = crf.predict(X_test)[0]

print("Conditional Random Field (CRF) - Named Entity Recognition\n")
print("Entities Defined: B-PER (Person/Customer), B-PROD (Product), B-ID (Order ID), O (Other)\n")
print(f"{'Token':<15} | {'Predicted Entity Label':<20}")
print("-" * 38)
for token, label in zip(test_sentence, y_pred):
    print(f"{token:<15} | {label:<20}")
