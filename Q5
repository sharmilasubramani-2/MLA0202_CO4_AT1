import warnings
warnings.filterwarnings('ignore')

import pandas as pd
from pgmpy.models import DiscreteBayesianNetwork
from pgmpy.estimators import HillClimbSearch, BicScore, MaximumLikelihoodEstimator
from pgmpy.inference import VariableElimination

print("NAME: SHARMILA S")
print("REGISTER NO: 192525011\n")

data = pd.DataFrame({
    'Age': ['Young', 'Young', 'Middle', 'Old', 'Young', 'Middle', 'Old', 'Middle', 'Old', 'Young'],
    'Income': ['Low', 'High', 'Medium', 'High', 'Low', 'Medium', 'Low', 'High', 'Medium', 'Medium'],
    'VehicleType': ['Car', 'Bike', 'Car', 'Car', 'Bike', 'Car', 'Bike', 'Car', 'Car', 'Bike'],
    'Claim': ['Yes', 'No', 'No', 'Yes', 'Yes', 'No', 'Yes', 'No', 'Yes', 'Yes']
})

hc = HillClimbSearch(data)
best_model_structure = hc.estimate(scoring_method=BicScore(data))

model = DiscreteBayesianNetwork(best_model_structure.edges())
model.fit(data, estimator=MaximumLikelihoodEstimator)

print("Bayesian Network Learning from Historical Data")
print("Dataset Variables: Age, Income, VehicleType, Claim\n")

print("Learned Network Dependencies (DAG Edges):")
for u, v in model.edges():
    print(f"  {u} -> {v}")

infer = VariableElimination(model)
query_result = infer.query(
    variables=['Claim'], 
    evidence={'Age': 'Young', 'VehicleType': 'Bike'}
)

prob_claim_no = query_result.values[query_result.state_names['Claim'].index('No')]
prob_claim_yes = query_result.values[query_result.state_names['Claim'].index('Yes')]

print("\nProbabilistic Inference for New Customer:")
print("Evidence Given: Age = Young, VehicleType = Bike\n")
print(f"Probability of Claim = Yes : {prob_claim_yes * 100:.2f}% ({prob_claim_yes:.4f})")
print(f"Probability of Claim = No  : {prob_claim_no * 100:.2f}% ({prob_claim_no:.4f})")
