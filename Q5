import warnings
warnings.filterwarnings('ignore')

import pandas as pd
from pgmpy.models import DiscreteBayesianNetwork
from pgmpy.estimators import HillClimbSearch
from pgmpy.inference import VariableElimination

print("NAME: SHARMILA S")
print("REGISTER NO: 192525011\n")

raw_data = {
    'Age': ['Young', 'Young', 'Middle', 'Old', 'Young', 'Middle', 'Old', 'Middle', 'Old', 'Young'] * 5,
    'Income': ['Low', 'High', 'Medium', 'High', 'Low', 'Medium', 'Low', 'High', 'Medium', 'Medium'] * 5,
    'VehicleType': ['Bike', 'Car', 'Car', 'Car', 'Bike', 'Car', 'Bike', 'Car', 'Car', 'Bike'] * 5,
    'Claim': ['Yes', 'No', 'No', 'Yes', 'Yes', 'No', 'Yes', 'No', 'Yes', 'Yes'] * 5
}
data = pd.DataFrame(raw_data)

hc = HillClimbSearch(data)
# Learn structure (show_progress=False hides the loading bar)
best_model_structure = hc.estimate(scoring_method='bic-d', show_progress=False)

model = DiscreteBayesianNetwork()
model.add_nodes_from(data.columns)
model.add_edges_from(best_model_structure.edges())

# Let pgmpy use its default Maximum Likelihood Estimator automatically
model.fit(data)

print("Bayesian Network Learning from Historical Data")
print("Dataset Variables: Age, Income, VehicleType, Claim\n")

print("Learned Network Dependencies (DAG Edges):")
if len(model.edges()) > 0:
    for u, v in model.edges():
        print(f"  {u} -> {v}")
else:
    print("  Independent structure learned under BIC regularization")

infer = VariableElimination(model)
query_result = infer.query(
    variables=['Claim'], 
    evidence={'Age': 'Young', 'VehicleType': 'Bike'}
)

print("\nProbabilistic Inference for New Customer:")
print("Evidence Given: Age = Young, VehicleType = Bike\n")

claim_states = query_result.state_names['Claim']
for state, prob in zip(claim_states, query_result.values):
    print(f"Probability of Claim = {state:<4}: {prob * 100:.2f}% ({prob:.4f})")
